generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  AUTHOR
  REVIEWER
  EDITOR
  ADMIN
  /// Senior editor. Implicitly holds EDITOR, REVIEWER and AUTHOR rights —
  /// see `expandRoles()` in src/utils/roles.ts.
  CHIEF_EDITOR
  /// Editor without the chief editor's implicit reviewer/author rights.
  ASSOCIATE_EDITOR
}

/// Five-point scale used by every item in the manuscript review form's
/// "Assessment of the article" section.
enum ReviewRating {
  EXCELLENT
  GOOD
  MODERATE
  POOR
  BAD
}

enum ManuscriptStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  REVISION_REQUIRED
}

enum ReviewerProgress {
  NOT_STARTED
  BEGIN_REVIEW
  IN_PROGRESS
  FINISHED_REVIEW
}

/// Whether a reviewer has accepted the manuscript they were assigned. A
/// freshly created assignment is PENDING until the reviewer responds to the
/// notification / email; DECLINED keeps the row (with a reason) as a record.
enum AssignmentResponse {
  PENDING
  ACCEPTED
  DECLINED
}

/// Lifecycle of an editor's "become a reviewer" invitation.
enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ReviewRecommendation {
  ACCEPT
  MINOR_REVISION
  MAJOR_REVISION
  REJECT
}

enum EditorialDecisionType {
  ACCEPT
  REJECT
  REQUEST_REVISION
}

/// Which pass through the pipeline a decision belongs to. Null on decisions
/// made before this distinction existed. Initial screening happens before
/// peer review (desk decision); final screening happens after reviews are
/// in. Both use the same EditorialDecisionType outcomes — only who gets
/// notified, and which manuscripts are eligible, differs by stage.
enum DecisionStage {
  INITIAL_SCREENING
  FINAL_SCREENING
}

/// Who produced a given manuscript file version.
enum FileSource {
  AUTHOR
  EDITOR
}

/// How the account authenticates. LOCAL = email + password, GOOGLE = Google
/// Identity Services, BOTH = a local account that has been linked to Google.
enum AuthProvider {
  LOCAL
  GOOGLE
  BOTH
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  /// Null for accounts created purely through Google sign-in.
  passwordHash String?
  /// The account's primary role: decides which portal the user lands on after
  /// signing in, and is always a member of `roles`.
  role         Role
  /// Every role the account holds. An account may be, say, both an AUTHOR and a
  /// REVIEWER. Authorization reads this list (expanded via `expandRoles()`),
  /// never `role` alone. Backfilled from `role` for pre-existing accounts.
  roles        Role[]
  firstName    String?
  lastName     String?
  affiliation  String?

  /// FR-AUTH-1 — every non-admin account must confirm ownership of its email
  /// address before it can sign in. Admins are provisioned pre-verified by the
  /// seed script; Google accounts inherit Google's own verification.
  emailVerified   Boolean      @default(false)
  emailVerifiedAt DateTime?
  authProvider    AuthProvider @default(LOCAL)
  /// Google's stable subject identifier ("sub" claim). Unique when present.
  googleId        String?      @unique
  avatarUrl       String?

  /// Soft-disable: an inactive account keeps its data but cannot sign in.
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  manuscriptsAuthored Manuscript[]           @relation("AuthorManuscripts")
  reviewAssignments ReviewAssignment[]      @relation("ReviewerAssignments")
  assignmentsMade    ReviewAssignment[]      @relation("EditorAssignments")
  reviewerInvitationsSent ReviewerInvitation[] @relation("SentReviewerInvitations")
  reviews            Review[]
  editorialDecisions EditorialDecision[]
  reviewerFeedback   ReviewerFeedback[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  notifications      Notification[]

  @@index([emailVerified])
}

/// FR-AUTH-1 — single-use, hashed, expiring email confirmation tokens.
/// Only the SHA-256 hash is stored so a database leak cannot be replayed.
model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  /// Throttles "resend verification" abuse (FR-AUTH-1c).
  sentCount  Int       @default(1)
  lastSentAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model JournalSettings {
  id                        Int       @id @default(1)
  submissionDeadline        DateTime?
  openForSubmissions        Boolean   @default(true)
  /// Gates the scheduler's daily backup job (src/services/scheduler.ts) — the
  /// job itself always exists, this just lets an admin pause it.
  automaticBackupsEnabled   Boolean   @default(true)
  /// Gates outbound SMTP mail (src/services/email.ts sendMail) — in-app
  /// notification-bell rows are unaffected, this only silences real email.
  emailNotificationsEnabled Boolean   @default(true)
  updatedAt                 DateTime  @updatedAt
}

model Manuscript {
  id          String           @id @default(uuid())
  authorId    String
  author      User             @relation("AuthorManuscripts", fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  abstract    String
  keywords    String[]
  /// Optional — authors may submit without pasting a reference list.
  references  String?          @db.Text
  status      ManuscriptStatus @default(SUBMITTED)
  /// Author ticked "revised manuscript" on the submission form — tells the
  /// editor and reviewers this is a revised version of earlier work rather
  /// than a fresh submission. Also set when a revision file is uploaded.
  isRevised   Boolean          @default(false)
  /// The submission deadline in effect (JournalSettings.submissionDeadline)
  /// at the moment this manuscript was submitted — lets manuscripts be
  /// grouped by submission period. Null for submissions made before this
  /// field existed, or when no deadline was set at submission time.
  submissionDeadline DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  files        ManuscriptFile[]
  coAuthors    CoAuthor[]
  assignments  ReviewAssignment[]
  decisions    EditorialDecision[]
  publication  Publication?
  notifications Notification[]

  @@index([authorId])
  @@index([status])
}

/// A co-author listed on a submission. These are not JIDA accounts — they are
/// contact details captured on the submission form, so a co-author can be
/// recorded without having registered.
model CoAuthor {
  id             String     @id @default(uuid())
  manuscriptId   String
  manuscript     Manuscript @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)
  fullName       String
  /// Optional — only the co-author's name is required on the submission form.
  email          String?
  affiliation    String?
  /// Whether this co-author also fields correspondence about the manuscript.
  isCorresponding Boolean   @default(false)
  /// Author order as entered on the submission form.
  position       Int        @default(0)
  createdAt      DateTime   @default(now())

  @@index([manuscriptId])
}

model ManuscriptFile {
  id             String     @id @default(uuid())
  manuscriptId   String
  manuscript     Manuscript @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)
  storedName     String
  originalName   String
  mimeType       String
  sizeBytes      Int
  versionLabel   Int        @default(1)
  isLatest       Boolean    @default(true)
  source         FileSource @default(AUTHOR)
  /// Editor's notes on this version. Only set when source = EDITOR.
  remarks        String?    @db.Text
  createdAt      DateTime   @default(now())

  @@index([manuscriptId])
}

model ReviewAssignment {
  id           String           @id @default(uuid())
  manuscriptId String
  manuscript   Manuscript       @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     User             @relation("ReviewerAssignments", fields: [reviewerId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   User             @relation("EditorAssignments", fields: [assignedById], references: [id], onDelete: Cascade)
  deadline     DateTime
  progress     ReviewerProgress @default(NOT_STARTED)
  /// Whether the reviewer has accepted this specific assignment. They are
  /// notified (in-app + email) on assignment and must accept before the
  /// review form opens; declining stores a reason and notifies the editor.
  response      AssignmentResponse @default(PENDING)
  declineReason String?            @db.Text
  respondedAt   DateTime?
  /// SHA-256 hash of the magic-link token that lets the reviewer accept or
  /// decline straight from the assignment email without signing in.
  responseToken String?            @unique
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  review Review?

  @@unique([manuscriptId, reviewerId])
  @@index([reviewerId])
}

/// An editor's invitation for someone to join JIDA as a reviewer. Sent by
/// email to any address; accepting provisions a REVIEWER account (or adds the
/// role to an existing one). Only the token hash is stored so a database dump
/// cannot be replayed.
model ReviewerInvitation {
  id            String           @id @default(uuid())
  email         String
  /// The editor's personal note, shown verbatim in the invitation email.
  message       String           @db.Text
  invitedById   String
  invitedBy     User             @relation("SentReviewerInvitations", fields: [invitedById], references: [id], onDelete: Cascade)
  tokenHash     String           @unique
  status        InvitationStatus @default(PENDING)
  declineReason String?          @db.Text
  expiresAt     DateTime
  respondedAt   DateTime?
  createdAt     DateTime         @default(now())

  @@index([email])
  @@index([invitedById])
}

model Review {
  id                 String               @id @default(uuid())
  assignmentId       String               @unique
  assignment         ReviewAssignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  reviewerId         String
  reviewer           User                 @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  // ── "Comments and Suggestions to the Author(s)" — the only section of the
  //    review form the author is ever shown. ──────────────────────────────
  /// "Please provide an overall evaluation of the manuscript briefly (100-200
  /// words)". For manuscripts that cannot be published, the inadequacies.
  commentsToAuthor   String               @db.Text
  /// "Please provide reasons for acceptance or rejection as well as any
  /// suggestions ... for revisions or improvements."
  specificSuggestions String?             @db.Text

  /// "Confidential Comments (if any)" — explicitly never shown to authors.
  /// Optional because the form marks the section "if any"; older rows that
  /// predate the form carry the reviewer's editor-only notes here.
  commentsToEditor   String?              @db.Text

  // ── "Assessment of the article" — seven rated items. Nullable so reviews
  //    submitted before the form existed still read back cleanly. ─────────
  ratingTitle        ReviewRating?
  ratingAbstract     ReviewRating?
  ratingLiterature   ReviewRating?
  ratingMethods      ReviewRating?
  ratingConclusions  ReviewRating?
  ratingReferences   ReviewRating?
  ratingStructure    ReviewRating?

  /// "Overall Recommendation" — the form's four levels map onto this enum.
  recommendation     ReviewRecommendation
  /// Optional annotated/marked-up file the reviewer attaches alongside their comments.
  attachmentStoredName   String?
  attachmentOriginalName String?
  attachmentMimeType     String?
  attachmentSizeBytes    Int?
  createdAt          DateTime             @default(now())

  authorFeedback     ReviewerFeedback?

  @@index([reviewerId])
}

/// "Authors' Feedback of Reviewer's Work to JIDA" — the author's rating of how
/// useful a reviewer's review was. Written by the author, read by editors; the
/// reviewer never sees it.
model ReviewerFeedback {
  id        String   @id @default(uuid())
  reviewId  String   @unique
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// "Rating Result [Poor] 1-5 [Excellent]".
  rating    Int
  /// "Specific evaluation to the Reviewer's review result".
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
}

model EditorialDecision {
  id           String                @id @default(uuid())
  manuscriptId String
  manuscript   Manuscript            @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)
  editorId     String
  editor       User                  @relation(fields: [editorId], references: [id], onDelete: Cascade)
  decision     EditorialDecisionType
  /// Null on decisions made before initial/final screening was distinguished.
  stage        DecisionStage?
  notes        String?               @db.Text
  createdAt    DateTime              @default(now())

  @@index([manuscriptId])
}

model Issue {
  id          String   @id @default(uuid())
  volume      Int
  issueNumber Int
  year        Int
  title       String?
  /// Marks this issue as a special issue, so its publications can be
  /// classified separately in the archive.
  specialIssue Boolean @default(false)
  createdAt   DateTime @default(now())

  publications Publication[]

  @@unique([volume, issueNumber, year])
}

model Publication {
  id            String     @id @default(uuid())
  issueId       String
  issue         Issue      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  manuscriptId  String     @unique
  manuscript    Manuscript @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)
  slug          String     @unique
  scholarReady  Boolean    @default(false)
  publishedAt   DateTime   @default(now())

  @@index([issueId])
}

/// A reader who asked to be notified when a new issue is published. Public —
/// no account required, so there is no `User` relation.
model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

/// A user-set reminder tied to a manuscript. In-app only — no email is sent.
/// A reminder becomes visible purely by the clock passing `visibleAt`, so no
/// background job is needed: the list endpoint just filters on it.
model Notification {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  manuscriptId String?
  manuscript   Manuscript? @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)
  title        String
  body         String
  /// What this notification is about, so the frontend can render the right
  /// affordances: GENERIC (plain), REVIEW_ASSIGNMENT (Accept/Decline the
  /// assignment `refId`), ASSIGNMENT_RESPONSE / REVIEWER_INVITATION (outcome
  /// notices to the editor).
  kind         String      @default("GENERIC")
  /// Id of the row the notification's actions target (a ReviewAssignment or
  /// ReviewerInvitation), when `kind` is not GENERIC.
  refId        String?
  visibleAt    DateTime
  readAt       DateTime?
  createdAt    DateTime    @default(now())

  @@index([userId, visibleAt])
}
