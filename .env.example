# --- Local development ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jida?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_EXPIRES_MIN="15"
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"
UPLOAD_DIR="./uploads"

# Public URL of the Next.js frontend. Verification and password-reset emails
# link here, so it must be the address users actually browse to — NOT the API.
APP_URL="http://localhost:3000"

# Optional SMTP (TLS). Leave empty to log emails to console in development.
#
# IMPORTANT: in production SMTP is required. Email verification gates sign-in,
# so without a working mail server nobody can register.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="JIDA <noreply@auca.rw>"

# --- Email verification (FR-AUTH-1) ---
# How long a verification link stays valid.
EMAIL_VERIFICATION_TTL_HOURS="24"
# Minimum seconds between "resend verification" requests for one account.
EMAIL_VERIFICATION_RESEND_COOLDOWN_SEC="60"
# Hard cap on verification emails per address before support must intervene.
EMAIL_VERIFICATION_MAX_SENDS="5"

# --- Google sign-in (FR-AUTH-2) ---
# OAuth 2.0 Web application client ID from the Google Cloud Console
# (APIs & Services → Credentials). Leave empty to disable Google sign-in:
# the API then returns 501 and the frontend hides the button.
#
# Add these to the client's "Authorized JavaScript origins":
#   http://localhost:3000          (development)
#   https://your-frontend-domain   (production)
# No redirect URI is needed — the popup flow returns an ID token directly.
#
# The frontend reads this from the API (GET /api/auth/google/config), so it only
# needs to be set here, not duplicated in the Next.js environment.
GOOGLE_CLIENT_ID=""

# --- Render (set in Dashboard or via render.yaml) ---
# Render injects PORT automatically — do not hardcode it in production.
# PORT=<injected by Render>
# NODE_ENV=production
# DATABASE_URL=<from linked Postgres service>
# JWT_SECRET=<auto-generated by render.yaml, or set manually>
# CORS_ORIGIN=https://your-frontend.onrender.com
# APP_URL=https://your-frontend.onrender.com
# UPLOAD_DIR=/var/data/uploads
# SMTP_*=<configure for production email — required, not optional>
# GOOGLE_CLIENT_ID=<from Google Cloud Console>
